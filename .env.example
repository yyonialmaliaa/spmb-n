# Prisma schema uses PostgreSQL. Use a dedicated non-root production role.
DATABASE_URL="postgresql://spmb_app:CHANGE_ME@127.0.0.1:5432/spmb_db?schema=public"
# Must be a newly generated random value of at least 32 characters.
NEXTAUTH_SECRET="CHANGE_ME"
NEXTAUTH_URL="https://spmb.example.sch.id"

# Required by /api/upload. Keep these server-side; never use NEXT_PUBLIC_*.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Only needed when intentionally running `npm run db:seed` on a fresh database.
# Never use these as shared/default production credentials.
SEED_SUPERADMIN_PASSWORD=""
SEED_SPMB_ADMIN_PASSWORD=""
SEED_LOKET_ADMIN_PASSWORD=""

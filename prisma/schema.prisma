generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role: "super_admin" | "admin_spmb" | "admin_keuangan" | "user".
// Jenjang BUKAN role — jenjang adalah scope data (lihat scopeJenjang).
// Nilai lama "admin" dipetakan ke "super_admin" oleh normalizeRole() di
// lib/permissions.ts, supaya JWT yang terbit sebelum migrasi tetap valid.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  password     String
  role         String       @default("user")
  namaLengkap  String?
  aktif        Boolean      @default(true)
  lastLoginAt  DateTime?
  scopeJenjang String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  pendaftaran  Pendaftaran?

  @@index([role])
}

// Jejak audit untuk aksi yang berdampak: ubah harga/diskon, aktivasi tahun
// ajaran, verifikasi pembayaran, reset password, kelola pengguna.
//
// actorId & tahunAjaranId SENGAJA bukan relasi. Seluruh anak TahunAjaran
// memakai onDelete: Cascade dan /api/admin/tahun-ajaran/[id] DELETE benar-
// benar menghapus tahun ajaran — relasi akan ikut menghapus jejak audit dari
// persis aksi destruktif yang ingin dicatat. Sama untuk User.
model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorEmail    String
  actorRole     String
  aksi          String
  entitas       String
  entitasId     String?
  ringkasan     String
  sebelum       Json?
  sesudah       Json?
  jenjang       String?
  tahunAjaranId String?
  ip            String?
  createdAt     DateTime @default(now())

  @@index([entitas, entitasId, createdAt])
  @@index([tahunAjaranId, createdAt])
  @@index([actorId, createdAt])
}

model TahunAjaran {
  id                 String               @id @default(cuid())
  nama               String               @unique
  aktif              Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  diskonList         Diskon[]
  dokumenList        DokumenPersyaratan[]
  gelombangList      Gelombang[]
  hargaList          Harga[]
  pendaftaranList    Pendaftaran[]
  pengaturan         PengaturanKeuangan?
  praPendaftaranList PraPendaftaran[]
}

model Harga {
  id              String        @id @default(cuid())
  tahunAjaranId   String
  jenjang         String
  jurusan         String
  kelas           String
  nominal         Int
  aktif           Boolean       @default(true)
  urutan          Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tahunAjaran     TahunAjaran   @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  pendaftaranList Pendaftaran[]

  @@unique([tahunAjaranId, jenjang, jurusan, kelas])
  @@index([tahunAjaranId, jenjang])
}

model Diskon {
  id              String        @id @default(cuid())
  tahunAjaranId   String
  jenis           String
  tipeNominal     String        @default("rupiah")
  nominal         Int
  aktif           Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tahunAjaran     TahunAjaran   @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  pendaftaranList Pendaftaran[]

  @@index([tahunAjaranId])
}

model PengaturanKeuangan {
  id                    String      @id @default(cuid())
  tahunAjaranId         String      @unique
  minimalPembayaranAwal Int         @default(200000)
  minimalCicilan        Int         @default(100000)
  updatedAt             DateTime    @updatedAt
  tahunAjaran           TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
}

model Gelombang {
  id              String        @id @default(cuid())
  tahunAjaranId   String
  jenjang         String
  untukAlumni     Boolean       @default(false)
  nama            String
  urutan          Int           @default(1)
  tanggalMulai    DateTime?
  tanggalSelesai  DateTime?
  // diskonPersen: HANYA label tampilan (mis. landing page "Diskon 20%") —
  // TIDAK dipakai untuk menghitung tagihan. diskonNominal: potongan RUPIAH
  // sesungguhnya, dipakai lib/keuangan.ts untuk menghitung tagihan. Keduanya
  // diisi bebas oleh admin, tidak saling diturunkan (satu gelombang bisa
  // berlaku untuk banyak baris Harga dengan nominal berbeda-beda, jadi tidak
  // ada satu "harga acuan" tunggal untuk mengonversi % <-> Rp secara pasti).
  diskonPersen    Float         @default(0)
  diskonNominal   Int           @default(0)
  aktif           Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tahunAjaran     TahunAjaran   @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  pendaftaranList Pendaftaran[]

  @@index([tahunAjaranId, jenjang, untukAlumni])
}

model Pendaftaran {
  id                     String            @id @default(cuid())
  userId                 String?           @unique
  tahunAjaranId          String
  namaLengkap            String?
  namaPanggilan          String?
  tempatLahir            String?
  tanggalLahir           String?
  ttl                    String?
  jenisKelamin           String?
  agama                  String?
  anakKe                 String?
  alamat                 String?
  rt                     String?
  rw                     String?
  kelurahan              String?
  kecamatan              String?
  kabupaten              String?
  beratBadan             String?
  tinggiBadan            String?
  golonganDarah          String?
  nisn                   String?
  nik                    String?
  noPribadi              String?
  ukuranSeragam          String?
  namaPemberiReferensi   String?
  noHpReferensi          String?
  asalSD                 String?
  asalSMP                String?
  asalSekolah            String?
  jurusan                String?
  jenjang                String            @default("smk")
  kelas                  String?
  tipePendaftaran        String            @default("baru")
  kelasMasuk             String?
  sumberDaftar           String            @default("online")
  alumniSmpCitraNegara   Boolean?
  namaAyah               String?
  ttlAyah                String?
  pendidikanAyah         String?
  pekerjaanAyah          String?
  penghasilanAyah        String?
  noHpAyah               String?
  alamatAyah             String?
  namaIbu                String?
  ttlIbu                 String?
  pendidikanIbu          String?
  pekerjaanIbu           String?
  penghasilanIbu         String?
  noHpIbu                String?
  alamatIbu              String?
  namaWali               String?
  ttlWali                String?
  pendidikanWali         String?
  pekerjaanWali          String?
  penghasilanWali        String?
  noHpWali               String?
  alamatWali             String?
  namaOrtu               String?
  noOrtu                 String?
  jenisIjazah            String?
  fileIjazah             String?
  fileAkte               String?
  fileKK                 String?
  fileKtpOrtu            String?
  fileFoto               String?
  status                 String            @default("draft")
  nilaiSeleksi           Float?
  catatan                String?
  alasanPenolakan        String?
  waVerified             Boolean           @default(false)
  hargaId                String?
  hargaPokok             Int?
  gelombangId            String?
  gelombang              String?
  gelombangDiskonNominal Int               @default(0)
  diskonId               String?
  diskonNominal          Int               @default(0)
  totalTagihan           Int?
  totalTagihanLocked     Boolean           @default(false)
  metodePembayaran       String?
  buktiPembayaran        String?
  statusPembayaran       String            @default("belum_bayar")
  catatanPembayaran      String?
  tanggalBayar           DateTime?
  revisiCount            Int               @default(0)
  lastRevisiAt           DateTime?
  pesanPengumuman        String?
  sudahDaftarUlang       Boolean           @default(false)
  tanggalDaftarUlang     DateTime?
  catatanDaftarUlang     String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  diskonNama             String?
  lastStep               Int?
  // Nomor resmi "SPMB/0001/SMP/2026-2027/A7K9" — dibuat SEKALI, tepat saat
  // formulir berhasil dikirim (online: draft->verified di
  // app/api/pendaftaran/kirim; offline: saat admin membuat datanya), lewat
  // lib/nomorPendaftaran.ts. null untuk draft yang belum pernah dikirim.
  // @unique bukan hanya format rapi — itulah yang menegakkan "aman dari
  // duplikasi" di level database, bukan cuma di kode pembuatnya.
  noPendaftaran          String?           @unique
  // Momen yang SAMA dengan noPendaftaran dibuat — dipisah dari createdAt
  // (yang tercatat saat draft PERTAMA disimpan, bisa hari yang berbeda)
  // supaya "Pendaftar Hari Ini" di Dashboard menghitung hari FORMULIR
  // DIKIRIM, bukan hari draft-nya mulai diisi.
  submittedAt            DateTime?
  // Dicatat SEKALI, saat statusPembayaran pertama kali menjadi "lunas" —
  // dipakai untuk statistik "Pelunasan Hari Ini". Tidak ditimpa oleh
  // pelunasan berikutnya (mis. lunas -> refund sebagian -> lunas lagi tetap
  // memegang tanggal lunas yang PERTAMA).
  tanggalLunas           DateTime?
  // Checklist per-berkas di tab Verifikasi: { [fieldKey]: { status: "valid"
  // | "revisi", catatan?: string } }, mis. { fileKK: { status: "valid" } }.
  // Menandai satu berkas "revisi" sekaligus mengubah status jadi "ditolak"
  // dengan alasanPenolakan yang merangkum semua berkas bertanda revisi.
  validasiBerkas         Json?
  notifikasiList         Notifikasi[]
  pembayaranList         Pembayaran[]
  mutasiList             MutasiPendaftar[]
  praPendaftaran         PraPendaftaran?
  diskon                 Diskon?           @relation(fields: [diskonId], references: [id])
  gelombangRelasi        Gelombang?        @relation(fields: [gelombangId], references: [id])
  harga                  Harga?            @relation(fields: [hargaId], references: [id])
  tahunAjaran            TahunAjaran       @relation(fields: [tahunAjaranId], references: [id])
  user                   User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tahunAjaranId, jenjang])
}

// Penghitung urutan pendaftar per (tahun ajaran, jenjang) — tulang punggung
// noPendaftaran. Satu baris per kombinasi, nilainya HANYA PERNAH bertambah
// (lihat lib/nomorPendaftaran.ts): increment atomik di level database lewat
// upsert, jadi aman dari duplikasi walau dua formulir disubmit bersamaan
// persis di detik yang sama.
model NomorUrutCounter {
  id            String   @id @default(cuid())
  tahunAjaranId String
  jenjang       String
  nilaiTerakhir Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([tahunAjaranId, jenjang])
}

// Antrean kedatangan tanpa akun; Pendaftaran resmi dibuat petugas lalu ditautkan lewat pendaftaranId.
model PraPendaftaran {
  id               String       @id @default(cuid())
  noPraPendaftaran String       @unique
  // Kunci publik halaman & PDF bukti — pendaftar tidak punya akun dan id tidak pernah dibuka ke publik.
  tokenAkses       String       @unique
  tahunAjaranId    String
  jenjang          String
  namaLengkap      String
  email            String
  noHp             String
  asalSekolah      String
  alamat           String
  jurusan          String?
  // menunggu | datang | diproses | selesai | kedaluwarsa
  status           String       @default("menunggu")
  batasKedatangan  DateTime
  datangAt         DateTime?
  dikonfirmasiOleh String?
  diprosesAt       DateTime?
  selesaiAt        DateTime?
  pendaftaranId    String?      @unique
  // Hash IP untuk pembatas kiriman berulang; IP mentah tidak disimpan.
  ipHash           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  tahunAjaran      TahunAjaran  @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)
  pendaftaran      Pendaftaran? @relation(fields: [pendaftaranId], references: [id], onDelete: SetNull)

  @@index([tahunAjaranId, jenjang, status])
  @@index([status, batasKedatangan])
  @@index([ipHash, createdAt])
  @@index([noHp])
}

// Terpisah dari NomorUrutCounter agar pra-pendaftaran tidak menghabiskan nomor urut pendaftaran resmi.
model PraPendaftaranCounter {
  id            String   @id @default(cuid())
  tahunAjaranId String
  jenjang       String
  nilaiTerakhir Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([tahunAjaranId, jenjang])
}

// Riwayat mutasi/pindah pendaftar (SMA <-> SMK, atau antar-jurusan SMK).
// Record Pendaftaran-nya TIDAK dibuat ulang — dipindah di tempat, sehingga
// biodata, berkas, status, pembayaran, dan notifikasi tetap menempel lewat
// id yang sama. Tabel ini menyimpan posisi SEBELUM pindah, termasuk nomor
// pendaftaran lama, supaya asal-usulnya tidak hilang. Rincian keuangan
// lengkap (harga, gelombang, diskon sebelum/sesudah) ada di AuditLog.
//
// diprosesOlehId sengaja bukan relasi ke User, sama seperti AuditLog: jejak
// ini tidak boleh ikut terhapus kalau akun admin-nya dihapus.
model MutasiPendaftar {
  id                String      @id @default(cuid())
  pendaftaranId     String
  dariJenjang       String
  dariJurusan       String?
  dariKelas         String?
  keJenjang         String
  keJurusan         String?
  keKelas           String
  noPendaftaranLama String?
  noPendaftaranBaru String
  tagihanLama       Int?
  tagihanBaru       Int
  // Total bersih yang sudah dibayar saat mutasi (lunas, dikurangi refund/alokasi).
  dibayarSaatMutasi Int
  alasan            String
  diprosesOlehId    String?
  diprosesOlehNama  String
  createdAt         DateTime    @default(now())
  pendaftaran       Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@index([pendaftaranId, createdAt])
  @@index([noPendaftaranLama])
}

model Pembayaran {
  id                String      @id @default(cuid())
  pendaftaranId     String
  jenis             String      @default("bayar")
  angsuranKe        Int
  nominal           Int
  metodePembayaran  String
  buktiPembayaran   String?
  bankPengirim      String?
  namaPengirim      String?
  alasanRefund      String?
  status            String      @default("menunggu_verifikasi")
  catatanAdmin      String?
  tanggalBayar      DateTime    @default(now())
  tanggalVerifikasi DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  kategoriAlokasi   String?
  pendaftaran       Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)
}

model Notifikasi {
  id            String      @id @default(cuid())
  pendaftaranId String
  pesan         String
  dibaca        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  pendaftaran   Pendaftaran @relation(fields: [pendaftaranId], references: [id], onDelete: Cascade)

  @@index([pendaftaranId, createdAt])
}

// Dua kategori dalam satu tabel:
//   kategori = "pendaftaran"  -> berkas yang WAJIB DIUNGGAH pendaftar.
//              fieldKey memetakan baris ini ke kolom file di Pendaftaran
//              (fileIjazah/fileAkte/fileKK/fileKtpOrtu/fileFoto),
//              sehingga formulir siswa tidak perlu tabel sendiri.
//   kategori = "daftar_ulang" -> template dokumen yang DIUNDUH pendaftar
//              (tata tertib, surat pernyataan, surat perjanjian); di sini
//              `url`/`namaFile` diisi admin lewat upload.
//
// @@unique melebar dengan kategori: baris lama otomatis dapat default
// "daftar_ulang", jadi keunikan lama tetap terjamin oleh kunci baru.
model DokumenPersyaratan {
  id            String      @id @default(cuid())
  jenjang       String
  kategori      String      @default("daftar_ulang")
  jenis         String
  nama          String
  deskripsi     String?
  fieldKey      String?
  wajib         Boolean     @default(true)
  aktif         Boolean     @default(true)
  url           String?
  namaFile      String?
  urutan        Int         @default(0)
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())
  tahunAjaranId String
  tahunAjaran   TahunAjaran @relation(fields: [tahunAjaranId], references: [id], onDelete: Cascade)

  @@unique([tahunAjaranId, jenjang, kategori, jenis])
  @@index([tahunAjaranId, jenjang, kategori, aktif])
}

// ---------------------------------------------------------------------------
// Notifikasi untuk ADMIN — berbeda dari model `Notifikasi` di atas, yang
// arahnya admin -> pendaftar dan terikat ke satu pendaftaran.
//
// Yang ini arahnya sistem -> admin, dan tujuannya adalah PERAN, bukan orang:
// sebuah sekolah bisa punya beberapa petugas Front Office, dan pendaftar baru
// harus terlihat oleh mereka semua. Super Admin melihat seluruh peran.
//
// `entitasId` sengaja BUKAN relasi ke Pendaftaran/Pembayaran: notifikasi
// adalah catatan bahwa sesuatu pernah terjadi, dan menghapus tahun ajaran
// (yang meng-cascade ke pendaftaran) tidak boleh ikut menghapus jejaknya.
// ---------------------------------------------------------------------------
model NotifikasiAdmin {
  id            String   @id @default(cuid())
  jenis         String // pendaftar_baru | revisi_masuk | pembayaran_perlu_verifikasi
  peran         String // peran tujuan; super_admin selalu melihat semuanya
  judul         String
  pesan         String
  tautan        String? // halaman kerja yang dituju saat notifikasi diklik
  jenjang       String?
  tahunAjaranId String?
  entitas       String? // pendaftaran | pembayaran
  entitasId     String?
  createdAt     DateTime @default(now())

  dibaca NotifikasiAdminDibaca[]

  @@index([peran, createdAt])
  @@index([createdAt])
}

// Status "sudah dibaca" HARUS per pengguna, bukan per notifikasi: satu baris
// notifikasi dilihat banyak admin, dan yang satu membacanya tidak berarti
// yang lain sudah.
model NotifikasiAdminDibaca {
  id           String   @id @default(cuid())
  notifikasiId String
  userId       String
  dibacaAt     DateTime @default(now())

  notifikasi NotifikasiAdmin @relation(fields: [notifikasiId], references: [id], onDelete: Cascade)

  @@unique([notifikasiId, userId])
  @@index([userId])
}
